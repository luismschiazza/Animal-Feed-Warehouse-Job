{
  "name": "agora-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "scripts": {
    "cli": "ts-node -r tsconfig-paths/register src/main-cli.ts",
    "demo:create": "node scripts/demo.cjs create",
    "demo:seed": "node scripts/demo.cjs seed",
    "demo:status": "node scripts/demo.cjs status",
    "demo:start": "node scripts/demo.cjs start",
    "demo:destroy": "node scripts/demo.cjs destroy",
    "test:demo-safety": "node --test scripts/demo.test.cjs",
    "test:cli-safety": "node --test test/cli-dispatch.smoke.cjs",
    "test:demo": "npm run build && ts-node -r tsconfig-paths/register test/demo-operations.smoke.ts",
    "audit:initialize": "ts-node -r tsconfig-paths/register src/commands/audit-initialize.script.ts",
    "audit:export": "ts-node -r tsconfig-paths/register src/commands/audit-export.script.ts",
    "bootstrap:organization": "ts-node -r tsconfig-paths/register src/commands/bootstrap-organization.script.ts",
    "build": "node scripts/build-with-tsc.cjs",
    "products:initialize": "ts-node -r tsconfig-paths/register src/commands/initialize-products.script.ts",
    "session-admission:initialize": "ts-node -r tsconfig-paths/register src/commands/initialize-session-admission.script.ts",
    "session-replacement:initialize": "ts-node -r tsconfig-paths/register src/commands/initialize-session-replacement.script.ts",
    "session-limits:initialize": "ts-node -r tsconfig-paths/register src/commands/initialize-session-limits.script.ts",
    "start": "node scripts/build-with-tsc.cjs --run",
    "start:dev": "node scripts/build-with-tsc.cjs --watch --run",
    "start:debug": "node scripts/build-with-tsc.cjs --watch --run --debug",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier \"{src,test}/**/*.ts\" --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:audit-operations": "ts-node -r tsconfig-paths/register test/audit-operations.smoke.ts",
    "test:products-operations": "ts-node -r tsconfig-paths/register test/products-operations.smoke.ts",
    "test:session-replacement-operations": "ts-node -r tsconfig-paths/register test/session-replacement-operations.smoke.ts",
    "test:session-admission-operations": "ts-node -r tsconfig-paths/register test/session-admission-operations.smoke.ts",
    "test:security-root": "ts-node -r tsconfig-paths/register test/security-root.smoke.ts",
    "test:sessions": "jest --config ./test/jest-sessions-integration.json --runInBand",
    "test:abac": "jest --config ./test/jest-abac-integration.json --runInBand"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^11.2.8",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "handlebars": "^4.7.10",
    "inline-css": "^4.0.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7",
    "nest-commander": "^3.20.1",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "30.5.2",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "test-exclude@7.0.2": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    },
    "jest-config@30.5.2": {
      "glob": "14.0.3"
    },
    "jest-runtime@30.5.2": {
      "glob": "14.0.3"
    },
    "@jest/reporters@30.5.2": {
      "glob": "14.0.3"
    },
    "eslint@10.14.0": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.4"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.4"
    },
    "@trivago/prettier-plugin-sort-imports@6.0.2": {
      "minimatch": "11.0.4"
    },
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    },
    "brace-expansion@^1.1.7": "1.1.21"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
