# Server configuration
HOST=0.0.0.0
PORT=3000

# #17 atomic admission requires an explicitly initialized replica set (not standalone).
# Host tools + LOCAL single-node Compose only; never use this topology in production.
# In Compose containers use mongo-db:27017 and omit directConnection.
# See docs/authorization/ATOMIC_SESSION_ADMISSION_STUDY.md before starting the API.
MONGO_URL=mongodb://127.0.0.1:27017/animal_feed_local?replicaSet=afwlocal&directConnection=true

# Security
# Use a long random string in production
# To generate a new JWT secret: npm run cli -- generate:jwt-secret
JWT_SECRET=change_me
JWT_EXPIRES_IN='15m'
# Refresh sessions expire after 7 days; refreshing does not extend this limit.
# Example:
# JWT_SECRET=3f9d9f4b-8587-4d3d-80bb-7baf3a17b8a1b34e9d91c2b3d71727c63f

# CORS
# Leave empty in local development to allow local clients.
# In production, set explicit origins such as https://app.example.com.
CORS_ORIGIN=
CORS_CREDENTIALS=true

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false

# Gmail account used to send emails
MAIL_USER=agora.system.school@gmail.com
MAIL_PASS=your_app_password_here

# Name and email shown to the recipients
MAIL_FROM=Agora School API
MAIL_FROM_MAIL=agora.system.school@gmail.com

# Logo used in email templates
MAIL_LOGO_URL=https://yourcdn.com/logo.png

# Address used by mailer seeder
MAIL_TEST_ADDRESS=test@example.com
